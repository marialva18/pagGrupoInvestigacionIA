---
import DevelopmentInfo from './DevelopmentInfo.astro';
---

<footer>
  <div class="container footer-inner">
    <span>INTGARTI · FISI · UNMSM</span>
    <span>Portal académico e informativo</span>
    <DevelopmentInfo />
  </div>
</footer>

<style>
  footer {
    padding: 38px 0;
    color: rgb(255 255 255 / 70%);
    background: var(--color-navy);
    font-size: 0.78rem;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  @media (max-width: 640px) {
    .footer-inner {
      flex-direction: column;
    }
  }
</style>
